---
// src/components/Cartelera.astro
// Cartelera musical estilo afiche de gala: el título en Great Vibes bordó,
// y los grupos, uno debajo del otro, cada uno en una foto con marco
// dorado doble, esquinas ornamentales, sello "En vivo", el nombre en Cinzel
// y una nota musical entre dos filetes.
//
// Entrada: el título aparece, y cada grupo entra desde un lado alternando;
// después la foto tiene un destello dorado, un acercamiento muy lento y
// chispas que suben.
//
// Todo se mide contra el ancho de la columna: 1cqw = 1% de ese ancho.

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Cartelera Musical";
const etiqueta = "Música en vivo";
const frase = "Celebremos nuestro amor con música en vivo";
const cierre = "¡Te esperamos en la pista!";

// ancho y alto: los de la foto, para que se vea entera y sin recortes
const grupos = [
    {
        nombre: "Andreita Muñoz",
        imagen: "/imagenes/grupos/andreita-munoz.webp",
        ancho: 900,
        alto: 892,
    },
    {
        nombre: "Eclíptiko",
        imagen: "/imagenes/grupos/ecliptiko.webp",
        ancho: 900,
        alto: 900,
    },
    {
        nombre: "Reny y los Legionarios",
        imagen: "/imagenes/grupos/reny-y-los-legionarios.webp",
        ancho: 900,
        alto: 720,
    },
    {
        nombre: "Kumbiamveros",
        imagen: "/imagenes/grupos/kumbiamveros.webp",
        ancho: 900,
        alto: 802,
    },
    {
        nombre: "Maroyu de los Hermanos Yucra",
        imagen: "/imagenes/grupos/hermanos-yucra.webp",
        ancho: 900,
        alto: 900,
    },
];
// ──────────────────────────────────────────────────────────────
---

<section id="seccion-cartelera" class="seccion">
    <!-- Resplandor dorado de fondo -->
    <div class="resplandor" aria-hidden="true"></div>

    <!-- ═══ TÍTULO ═══ -->
    <div id="cartelera-titulo" class="encabezado">
        <div class="etiqueta-fila cartelera-sub">
            <span class="hilo hilo-izq"></span>
            <span class="etiqueta">
                <span class="punto-vivo"></span>
                {etiqueta}
            </span>
            <span class="hilo hilo-der"></span>
        </div>

        <h2 class="titulo font-great-vibes cartelera-h2">{titulo}</h2>

        <p class="frase cartelera-sub">{frase}</p>

        <div class="adorno cartelera-sub" aria-hidden="true">
            <span class="adorno-linea"></span>
            <span class="adorno-rombo"></span>
            <span class="adorno-linea"></span>
        </div>
    </div>

    <!-- ═══ GRUPOS ═══ -->
    <div class="grupos">
        {
            grupos.map((g, i) => (
                <article class="grupo-card">
                    <!-- Foto con marco dorado doble -->
                    <div class="grupo-marco">
                        <span class="esquina esquina-tl" aria-hidden="true" />
                        <span class="esquina esquina-tr" aria-hidden="true" />
                        <span class="esquina esquina-bl" aria-hidden="true" />
                        <span class="esquina esquina-br" aria-hidden="true" />

                        <div
                            class="grupo-foto"
                            style={`aspect-ratio: ${g.ancho} / ${g.alto};`}
                        >
                            <img
                                src={g.imagen}
                                alt={g.nombre}
                                width={g.ancho}
                                height={g.alto}
                                loading="lazy"
                                class="grupo-img"
                            />
                            <!-- Degradado inferior para dar profundidad -->
                            <div class="grupo-sombra" />
                            <!-- Destello dorado que cruza la foto -->
                            <div class="grupo-destello" aria-hidden="true" />

                            <!-- Sello EN VIVO -->
                            <div class="sello">
                                <span class="punto-vivo" />
                                <span class="sello-texto">En vivo</span>
                            </div>

                            <!-- Número -->
                            <div class="numero">
                                N° {String(i + 1).padStart(2, "0")}
                            </div>
                        </div>

                        <!-- Nombre del grupo, dentro de la tarjeta -->
                        <div class="grupo-texto">
                            <h3 class="grupo-nombre">{g.nombre}</h3>
                            <div class="nota-fila">
                                <span class="grupo-linea grupo-linea-izq" />
                                <span class="nota">♪</span>
                                <span class="grupo-linea grupo-linea-der" />
                            </div>
                        </div>
                    </div>
                </article>
            ))
        }
    </div>

    <!-- Cierre -->
    <div id="credito-cartelera" class="cierre">
        <span class="cierre-linea cierre-izq"></span>
        <span class="cierre-texto font-great-vibes">{cierre}</span>
        <span class="cierre-linea cierre-der"></span>
    </div>
</section>

<style>
    .seccion {
        container-type: inline-size;
        position: relative;
        width: 100%;
        padding: 12cqw 6cqw 14cqw;
        overflow: hidden;
        text-align: center;
    }

    .resplandor {
        position: absolute;
        inset: 10% -20%;
        background-image:
            radial-gradient(
                ellipse at 50% 20%,
                rgba(176, 141, 87, 0.14),
                rgba(176, 141, 87, 0) 60%
            ),
            radial-gradient(
                ellipse at 50% 80%,
                rgba(122, 35, 53, 0.06),
                rgba(122, 35, 53, 0) 60%
            );
        pointer-events: none;
    }

    /* ── Encabezado ─────────────────────────────────────────── */
    .encabezado {
        position: relative;
        margin-bottom: 10cqw;
    }

    .etiqueta-fila {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3cqw;
        margin-bottom: 3cqw;
    }

    .hilo {
        display: block;
        width: 10cqw;
        height: 1px;
    }

    .hilo-izq {
        background-image: linear-gradient(
            90deg,
            rgba(176, 141, 87, 0),
            #b08d57
        );
    }

    .hilo-der {
        background-image: linear-gradient(
            270deg,
            rgba(176, 141, 87, 0),
            #b08d57
        );
    }

    .etiqueta {
        display: flex;
        align-items: center;
        gap: 2cqw;
        font-family: "Cinzel", serif;
        font-weight: 500;
        font-size: 3.2cqw;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: #9a7433;
    }

    /* Great Vibes no tolera mayúsculas forzadas ni espaciado entre letras */
    .titulo {
        margin: 0;
        padding: 0 4cqw;
        font-size: 13cqw;
        line-height: 1.15;
        color: #7a2335;
    }

    .frase {
        margin: 2.4cqw auto 0;
        max-width: 90%;
        font-family: "Cinzel", serif;
        font-size: 4.2cqw;
        line-height: 1.35;
        letter-spacing: 0.02em;
        color: #6e5a52;
    }

    .adorno {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2.4cqw;
        margin-top: 5cqw;
    }

    .adorno-linea {
        display: block;
        width: 16cqw;
        height: 1px;
        background-image: linear-gradient(
            90deg,
            rgba(176, 141, 87, 0.15),
            rgba(176, 141, 87, 0.7),
            rgba(176, 141, 87, 0.15)
        );
    }

    .adorno-rombo {
        display: block;
        width: 1.9cqw;
        height: 1.9cqw;
        border: 1px solid #b08d57;
        transform: rotate(45deg);
    }

    /* ── Grupos ─────────────────────────────────────────────── */
    .grupos {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 14cqw;
    }

    .grupo-card {
        position: relative;
    }

    /* Marco dorado doble */
    .grupo-marco {
        position: relative;
        padding: 2.4cqw;
        border: 1px solid rgba(176, 141, 87, 0.6);
        border-radius: 1.4cqw;
        /* Como imagen y no como color: el modo oscuro forzado la respeta */
        background-image: linear-gradient(#fbf9f5, #fbf9f5);
        box-shadow:
            0 18px 40px -18px rgba(70, 20, 30, 0.45),
            0 0 0 1cqw #fbf9f5,
            0 0 0 calc(1cqw + 1px) rgba(176, 141, 87, 0.4);
    }

    .grupo-foto {
        position: relative;
        overflow: hidden;
        border-radius: 0.7cqw;
    }

    .grupo-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform-origin: center;
        user-select: none;
        -webkit-user-drag: none;
    }

    .grupo-sombra {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(
            to top,
            rgba(70, 20, 30, 0.4),
            rgba(70, 20, 30, 0) 45%
        );
        pointer-events: none;
    }

    /* Esquinas ornamentales */
    .esquina {
        position: absolute;
        width: 5cqw;
        height: 5cqw;
        border-color: #b08d57;
        border-style: solid;
        z-index: 5;
        pointer-events: none;
    }
    .esquina-tl {
        top: -1.6cqw;
        left: -1.6cqw;
        border-width: 2px 0 0 2px;
    }
    .esquina-tr {
        top: -1.6cqw;
        right: -1.6cqw;
        border-width: 2px 2px 0 0;
    }
    .esquina-bl {
        bottom: -1.6cqw;
        left: -1.6cqw;
        border-width: 0 0 2px 2px;
    }
    .esquina-br {
        bottom: -1.6cqw;
        right: -1.6cqw;
        border-width: 0 2px 2px 0;
    }

    /* Destello dorado */
    .grupo-destello {
        position: absolute;
        top: 0;
        left: -60%;
        width: 45%;
        height: 100%;
        background-image: linear-gradient(
            100deg,
            rgba(255, 236, 170, 0),
            rgba(255, 236, 170, 0.45),
            rgba(255, 236, 170, 0)
        );
        transform: skewX(-18deg);
        pointer-events: none;
    }

    /* Sello EN VIVO */
    .sello {
        position: absolute;
        top: 2.6cqw;
        left: 2.6cqw;
        display: flex;
        align-items: center;
        gap: 1.6cqw;
        padding: 1cqw 3cqw;
        border-radius: 999px;
        background-image: linear-gradient(
            rgba(251, 249, 245, 0.92),
            rgba(251, 249, 245, 0.92)
        );
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }

    .sello-texto {
        font-family: "Cinzel", serif;
        font-weight: 700;
        font-size: 2.5cqw;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #7a2335;
    }

    .numero {
        position: absolute;
        right: 3.4cqw;
        bottom: 2.6cqw;
        font-family: "Cinzel", serif;
        font-weight: 600;
        font-size: 3cqw;
        letter-spacing: 0.3em;
        color: rgba(255, 255, 255, 0.92);
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
    }

    /* Nombre del grupo */
    .grupo-texto {
        padding: 4cqw 2cqw 2cqw;
    }

    .grupo-nombre {
        margin: 0;
        font-family: "Cinzel", serif;
        font-weight: 500;
        font-size: 5.4cqw;
        line-height: 1.25;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #7a2335;
    }

    .nota-fila {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3cqw;
        margin-top: 2.4cqw;
    }

    .grupo-linea {
        display: block;
        width: 14cqw;
        height: 1px;
    }

    .grupo-linea-izq {
        background-image: linear-gradient(
            90deg,
            rgba(176, 141, 87, 0),
            #b08d57
        );
        transform-origin: 100% 50%;
    }

    .grupo-linea-der {
        background-image: linear-gradient(
            270deg,
            rgba(176, 141, 87, 0),
            #b08d57
        );
        transform-origin: 0% 50%;
    }

    .nota {
        font-size: 4cqw;
        color: #b08d57;
    }

    /* Punto rojo "en vivo" que late */
    .punto-vivo {
        display: inline-block;
        width: 1.8cqw;
        height: 1.8cqw;
        border-radius: 9999px;
        background-image: linear-gradient(#c0392b, #c0392b);
        box-shadow: 0 0 0 0 rgba(192, 57, 43, 0.6);
        animation: latido-vivo 1.6s ease-out infinite;
    }

    @keyframes latido-vivo {
        0% {
            box-shadow: 0 0 0 0 rgba(192, 57, 43, 0.6);
        }
        70% {
            box-shadow: 0 0 0 1.8cqw rgba(192, 57, 43, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(192, 57, 43, 0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .punto-vivo {
            animation: none;
        }
    }

    /* ── Cierre ─────────────────────────────────────────────── */
    .cierre {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3.6cqw;
        margin-top: 14cqw;
    }

    .cierre-linea {
        display: block;
        flex: 1;
        max-width: 18cqw;
        height: 1px;
    }

    .cierre-izq {
        background-image: linear-gradient(
            90deg,
            rgba(176, 141, 87, 0),
            #b08d57
        );
    }

    .cierre-der {
        background-image: linear-gradient(
            270deg,
            rgba(176, 141, 87, 0),
            #b08d57
        );
    }

    .cierre-texto {
        font-size: 7cqw;
        line-height: 1.2;
        color: #9a7433;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    // Chispas doradas que suben desde la tarjeta
    function crearBrasa(card: HTMLElement) {
        const p = document.createElement("div");
        const size = Math.random() * 4 + 4;
        const esRedonda = Math.random() > 0.4;
        const startX = Math.random() * 86 + 7;
        const totalY = Math.random() * 80 + 60;
        const swayX = (Math.random() - 0.5) * 40;
        const duracion = Math.random() * 1.8 + 2.2;

        p.style.cssText = `
            position: absolute;
            width: ${size}px;
            height: ${esRedonda ? size : size * 1.6}px;
            background-image: radial-gradient(circle at 40% 40%, #F0D97A, #C9A84C, #9C7A2E);
            border-radius: ${esRedonda ? "50%" : "40% 60% 50% 50%"};
            pointer-events: none;
            z-index: 30;
            left: ${startX}%;
            bottom: 35%;
            opacity: 0;
            box-shadow: 0 0 ${size + 4}px rgba(230,190,80,0.85);
            transform: rotate(${Math.random() * 360}deg);
        `;
        card.appendChild(p);

        gsap.timeline({ onComplete: () => p.remove() })
            .to(p, {
                opacity: Math.random() * 0.4 + 0.55,
                duration: 0.4,
                ease: "power1.out",
            })
            .to(
                p,
                {
                    y: -totalY * 0.5,
                    x: swayX * 0.5,
                    rotation: `+=${Math.random() * 120 - 60}`,
                    duration: duracion * 0.5,
                    ease: "none",
                },
                0,
            )
            .to(p, {
                y: -totalY,
                x: swayX,
                opacity: 0,
                rotation: `+=${Math.random() * 120 - 60}`,
                duration: duracion * 0.5,
                ease: "power1.in",
            });
    }

    function iniciarChispas(card: HTMLElement) {
        if (card.dataset.chispas) return;
        card.dataset.chispas = "1";
        const emitir = () => {
            crearBrasa(card);
            setTimeout(emitir, Math.random() * 500 + 400);
        };
        setTimeout(emitir, Math.random() * 1500);
    }

    const initCartelera = () => {
        const reducido = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        // ═══ TÍTULO (se repite cada vez que se baja) ═══
        gsap.set("#cartelera-titulo .cartelera-sub", { opacity: 0, y: 15 });
        gsap.set("#cartelera-titulo .cartelera-h2", {
            opacity: 0,
            scale: 0.85,
            y: 20,
        });
        const tlTitulo = gsap
            .timeline({ paused: true })
            .to("#cartelera-titulo .cartelera-h2", {
                opacity: 1,
                scale: 1,
                y: 0,
                duration: 1.4,
                ease: "power3.out",
            })
            .to(
                "#cartelera-titulo .cartelera-sub",
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.9,
                    ease: "power2.out",
                    stagger: 0.15,
                },
                0.3,
            );

        ScrollTrigger.create({
            trigger: "#cartelera-titulo",
            start: "top 80%",
            onEnter: () => tlTitulo.timeScale(1).restart(),
            onLeaveBack: () => tlTitulo.timeScale(2.5).reverse(),
        });

        // ═══ CADA GRUPO ENTRA EN SECUENCIA, ALTERNANDO LADOS ═══
        document
            .querySelectorAll<HTMLElement>(".grupo-card")
            .forEach((card, i) => {
                const marco = card.querySelector(".grupo-marco");
                const img = card.querySelector(".grupo-img");
                const texto = card.querySelector(".grupo-texto");
                const lineas = card.querySelectorAll(".grupo-linea");
                const destello = card.querySelector(".grupo-destello");
                const lado = i % 2 === 0 ? -60 : 60;
                let efectos: gsap.core.Tween[] = [];

                gsap.set(marco, { opacity: 0, x: lado, y: 30 });
                gsap.set(img, { scale: 1.35, opacity: 0 });
                gsap.set(texto, { opacity: 0, y: 25 });
                gsap.set(lineas, { scaleX: 0 });

                const tl = gsap
                    .timeline({ paused: true })
                    .to(marco, {
                        opacity: 1,
                        x: 0,
                        y: 0,
                        duration: 1.1,
                        ease: "power3.out",
                    })
                    .to(
                        img,
                        { opacity: 1, duration: 1, ease: "power1.out" },
                        0.15,
                    )
                    .to(
                        img,
                        { scale: 1, duration: 2, ease: "power2.out" },
                        0.15,
                    )
                    .to(
                        texto,
                        { opacity: 1, y: 0, duration: 1, ease: "power2.out" },
                        0.8,
                    )
                    .to(
                        lineas,
                        { scaleX: 1, duration: 0.9, ease: "power2.out" },
                        1.1,
                    )
                    .call(() => {
                        if (reducido) return;
                        iniciarChispas(card);
                        efectos = [
                            // Destello dorado que cruza la foto cada tanto
                            gsap.fromTo(
                                destello,
                                { left: "-60%" },
                                {
                                    left: "130%",
                                    duration: 1.4,
                                    ease: "power2.inOut",
                                    repeat: -1,
                                    repeatDelay: 3.5,
                                },
                            ),
                            // Acercamiento muy lento de la foto
                            gsap.to(img, {
                                scale: 1.06,
                                duration: 8,
                                ease: "sine.inOut",
                                repeat: -1,
                                yoyo: true,
                            }),
                        ];
                    });

                const detenerEfectos = () => {
                    efectos.forEach((t) => t.kill());
                    efectos = [];
                    gsap.set(destello, { left: "-60%" });
                };

                ScrollTrigger.create({
                    trigger: card,
                    start: "top 80%",
                    onEnter: () => {
                        detenerEfectos();
                        tl.timeScale(1).restart(true);
                    },
                    onLeaveBack: () => {
                        detenerEfectos();
                        tl.timeScale(2.5).reverse();
                    },
                });
            });

        // ═══ CIERRE ═══
        gsap.set("#credito-cartelera", { opacity: 0, y: 15 });
        ScrollTrigger.create({
            trigger: "#credito-cartelera",
            start: "top 92%",
            onEnter: () =>
                gsap.to("#credito-cartelera", {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    ease: "power2.out",
                }),
            onLeaveBack: () =>
                gsap.to("#credito-cartelera", {
                    opacity: 0,
                    y: 15,
                    duration: 0.4,
                }),
        });
    };

    document.addEventListener("DOMContentLoaded", initCartelera);
</script>
